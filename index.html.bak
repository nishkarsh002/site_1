<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tech Hodu® — Websites that make brands impossible to ignore</title>
    <meta name="description"
        content="Strategy, UI/UX, WordPress and high-performance development for ambitious brands. Tech Hodu is your creative growth partner." />
    <link rel="icon" href="techhodu_logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        href="https://fonts.googleapis.com/css2?family=Science+Gothic:wght@100..900&family=Unbounded:wght@200..900&family=Manrope:wght@300;400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap"
        rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        mint: "#e7f6ea", ink: "#0f1518", muted: "#adbbc1", forest: "#135545",
                        mint2: "#d0edd6", slategrn: "#283b43", leaf: "#abe5b1", deep: "#1a2327",
                        sage: "#90c0a6", sea: "#78a17c", mist: "#f4f4f4", moss: "#4e905a",
                        n2: "#e7edf0", slate: "#86969d", n3: "#182126", n1: "#0c3c30",
                        bolt: "#fda79f", lime: "#d3f3d6", pine: "#135343", lights: "#aebcc2",
                        coral: "#f16060", ember: "#f65443", night: "#101619",
                    },
                    fontFamily: {
                        display: ['Unbounded', 'sans-serif'],
                        sans: ['Manrope', 'system-ui', 'sans-serif'],
                        mono: ['"Space Mono"', 'monospace'],
                    },
                    letterSpacing: { huge: '0.32em' },
                },
            },
        };
    </script>
    <style>
        :root {
            --ink: #0f1518;
            --leaf: #abe5b1;
            --forest: #135545;
            --mint: #e7f6ea;
            --ember: #f65443;
        }

        html {
            scroll-behavior: auto;
        }

        body {
            font-family: Manrope, system-ui, sans-serif;
            background: #f5f8f4;
            color: #0f1518;
            overflow-x: hidden;
            cursor: none;
        }

        .lenis.lenis-smooth {
            scroll-behavior: auto !important;
        }

        @media (pointer: coarse) {

            body,
            a,
            button {
                cursor: auto;
            }

            .cursor,
            .cursor-dot {
                display: none !important;
            }
        }

        .gridlines {
            background-image:
                linear-gradient(rgba(19, 85, 69, .05) 1px, transparent 1px),
                linear-gradient(90deg, rgba(19, 85, 69, .05) 1px, transparent 1px);
            background-size: 72px 72px;
        }

        .dotgrid {
            background-image: radial-gradient(rgba(171, 229, 177, .25) 1px, transparent 1.6px);
            background-size: 22px 22px;
        }

        .corners {
            position: relative;
        }

        .corners::before,
        .corners::after {
            content: "";
            position: absolute;
            width: 18px;
            height: 18px;
            z-index: 5;
            border-color: #abe5b1;
            border-style: solid;
            pointer-events: none;
        }

        .corners::before {
            top: -2px;
            left: -2px;
            border-width: 2px 0 0 2px;
        }

        .corners::after {
            bottom: -2px;
            right: -2px;
            border-width: 0 2px 2px 0;
        }

        details summary::-webkit-details-marker {
            display: none;
        }

        .sticky-cta {
            box-shadow: 0 -12px 40px rgba(16, 22, 25, .18);
        }

        /* cursor */
        .cursor {
            position: fixed;
            top: 0;
            left: 0;
            width: 42px;
            height: 42px;
            margin: -21px 0 0 -21px;
            border: 1.5px solid rgba(19, 85, 69, .5);
            border-radius: 2px;
            pointer-events: none;
            z-index: 10000;
            transition: width .35s cubic-bezier(.22, 1, .36, 1), height .35s, margin .35s, background .35s, border-radius .35s, opacity .3s;
        }

        .cursor-dot {
            position: fixed;
            top: 0;
            left: 0;
            width: 6px;
            height: 6px;
            margin: -3px 0 0 -3px;
            background: var(--ember);
            pointer-events: none;
            z-index: 10001;
            border-radius: 999px;
        }

        .cursor.hover {
            width: 76px;
            height: 76px;
            margin: -38px 0 0 -38px;
            background: rgba(171, 229, 177, .4);
            border-radius: 999px;
            border-color: transparent;
        }

        .cursor.drag {
            width: 90px;
            height: 90px;
            margin: -45px 0 0 -45px;
            background: rgba(19, 85, 69, .9);
            border-radius: 999px;
            border-color: transparent;
        }

        .cursor.drag::after {
            content: "DRAG";
            position: absolute;
            inset: 0;
            display: grid;
            place-items: center;
            color: #fff;
            font-size: 9px;
            letter-spacing: .2em;
            font-family: "Space Mono", monospace;
        }

        .cursor.view::after {
            content: "VIEW";
            position: absolute;
            inset: 0;
            display: grid;
            place-items: center;
            color: #0f1518;
            font-size: 9px;
            letter-spacing: .2em;
            font-family: "Space Mono", monospace;
            font-weight: 700;
        }

        /* preloader */
        #preloader {
            position: fixed;
            inset: 0;
            z-index: 9999;
            background: #0f1518;
            color: #abe5b1;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        #preloader.done {
            pointer-events: none;
        }

        .pre-bar {
            transform-origin: left center;
            transform: scaleX(0);
        }

        .pre-lines {
            overflow: hidden;
        }

        /* word / line reveal */
        .line-mask {
            overflow: hidden;
            display: block;
        }

        .word {
            display: inline-block;
            will-change: transform;
        }

        .reveal-up,
        .reveal-card {
            will-change: transform, opacity;
        }

        /* marquee */
        .mq {
            display: flex;
            width: max-content;
            animation: mq 26s linear infinite;
        }

        .mq.reverse {
            animation-direction: reverse;
        }

        .mq:hover {
            animation-play-state: paused;
        }

        @keyframes mq {
            to {
                transform: translateX(-50%);
            }
        }

        @keyframes floatY {

            0%,
            100% {
                transform: translate3d(0, 0, 0)
            }

            50% {
                transform: translate3d(0, -14px, 0)
            }
        }

        @keyframes spin360 {
            to {
                transform: rotate(360deg);
            }
        }

        .float-a {
            animation: floatY 6s ease-in-out infinite;
        }

        .float-b {
            animation: floatY 8s ease-in-out infinite reverse;
        }

        .spin-slow {
            animation: spin360 26s linear infinite;
        }

        /* HERO SHOWCASE SLIDER */
        .show-slide {
            position: absolute;
            inset: 0;
            opacity: 0;
            visibility: hidden;
        }

        .show-slide.active {
            opacity: 1;
            visibility: visible;
            z-index: 2;
        }

        .show-slide .show-img {
            transform: scale(1.16);
            filter: saturate(.85);
        }

        .show-slide.active .show-img {
            transform: scale(1);
            filter: saturate(1);
            transition: transform 7s cubic-bezier(.16, .84, .44, 1), filter 1.2s;
        }

        .show-cap {
            transition: transform .8s cubic-bezier(.22, 1, .36, 1), opacity .7s;
        }

        .show-slide .show-cap {
            transform: translateY(24px);
            opacity: 0;
        }

        .show-slide.active .show-cap {
            transform: translateY(0);
            opacity: 1;
        }

        .show-prog span {
            transform: scaleX(0);
            transform-origin: left;
        }

        .show-slide.active~.show-ui .show-prog span,
        .show-slide.active+* .show-prog span {
            animation: prog 6s linear forwards;
        }

        @keyframes prog {
            to {
                transform: scaleX(1);
            }
        }

        /* hscroll services */
        .hscroll-wrap {
            position: relative;
        }

        .hscroll-track {
            display: flex;
            gap: clamp(1rem, 1.6vw, 1.75rem);
            will-change: transform;
        }

        /* testimonial slider */
        .tsl {
            opacity: 0;
            visibility: hidden;
            position: absolute;
            inset: 0;
        }

        .tsl.active {
            opacity: 1;
            visibility: visible;
            position: relative;
            z-index: 2;
            animation: tslIn .7s cubic-bezier(.22, 1, .36, 1);
        }

        @keyframes tslIn {
            from {
                opacity: 0;
                transform: translateY(26px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .tsl-dot {
            transition: all .3s;
        }

        /* blog slider */
        .blog-scroller {
            scrollbar-width: none;
            -ms-overflow-style: none;
        }

        .blog-scroller::-webkit-scrollbar {
            display: none;
        }

        .snap-x {
            scroll-snap-type: x mandatory;
        }

        .snap-start {
            scroll-snap-align: start;
        }

        .noise {
            pointer-events: none;
            position: fixed;
            inset: 0;
            z-index: 80;
            opacity: .04;
            mix-blend-mode: overlay;
            background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
        }

        .progress-bar {
            position: fixed;
            top: 0;
            left: 0;
            height: 2px;
            width: 0;
            z-index: 90;
            background: linear-gradient(90deg, #135545, #abe5b1, #f65443);
        }

        .btn-square {
            position: relative;
            overflow: hidden;
            isolation: isolate;
        }

        .btn-square .fill {
            position: absolute;
            inset: auto auto -120% -20%;
            width: 140%;
            height: 230%;
            background: #abe5b1;
            z-index: -1;
            transform: translateY(0);
            transition: transform .5s cubic-bezier(.22, 1, .36, 1);
            border-radius: 999px;
        }

        .btn-square:hover .fill {
            transform: translateY(-56%);
        }

        .btn-square.dark {}

        .card-line {
            transition: border-color .4s, background .4s, transform .5s cubic-bezier(.22, 1, .36, 1);
        }

        .card-line:hover {
            border-color: rgba(19, 85, 69, .5);
            transform: translateY(-6px);
        }

        .num-ghost {
            -webkit-text-stroke: 1px rgba(19, 85, 69, .22);
            color: transparent;
        }
    </style>
</head>

<body class="antialiased">

    <div class="progress-bar" id="progressBar"></div>
    <div class="noise"></div>
    <div class="cursor" id="cursor"></div>
    <div class="cursor-dot" id="cursorDot"></div>

    <div id="preloader">
        <div class="w-[min(420px,86vw)] text-center relative">
            <p class="pre-lines font-mono text-[10px] tracking-huge uppercase text-leaf/70 mb-3">Tech Hodu</p>
            <h2 class="pre-lines font-display font-bold text-3xl md:text-4xl uppercase tracking-tight" id="preTitle">
                Elevating<br />Brands<span class="text-ember">.</span></h2>
            <div class="mt-7 h-[3px] bg-white/10 overflow-hidden">
                <div class="pre-bar h-full bg-leaf" id="preBar"></div>
            </div>
            <div class="mt-4 flex items-center justify-between font-mono text-[11px] text-white/60">
                <span>Loading experience</span><span class="text-leaf" id="preCount">00</span>
            </div>
            <img src="techhodu_logo.svg" alt=""
                class="pre-logo absolute -right-2 -top-2 h-12 w-12 bg-white rounded-md p-1" />
        </div>
    </div>

    <header id="siteHeader"
        class="sticky top-0 z-50 bg-[#f5f8f4]/80 backdrop-blur-xl border-b border-n2/70 transition-all duration-500">
        <div class="max-w-[1400px] mx-auto px-5 h-[72px] flex items-center justify-between gap-4">
            <a href="#home" data-cursor="hover" class="flex items-center gap-3 shrink-0 group">
                <img src="techhodu_logo.svg" alt="Tech Hodu"
                    class="h-9 w-9 object-contain group-hover:rotate-[360deg] transition-transform duration-700" />
                <span
                    class="font-display font-bold tracking-tight text-[17px] uppercase leading-none">Tech<br />Hodu<span
                        class="text-ember">.</span></span>
            </a>
            <nav class="hidden lg:flex items-center gap-9 font-mono text-[10px] uppercase tracking-[0.2em] text-deep">
                <a href="#home" class="relative hover:text-forest transition"><span class="text-ember">01.</span>
                    Home</a>
                <a href="#services" class="relative hover:text-forest transition"><span class="text-ember">02.</span>
                    Services</a>
                <a href="#work" class="relative hover:text-forest transition"><span class="text-ember">03.</span>
                    Work</a>
                <a href="#why-us" class="relative hover:text-forest transition"><span class="text-ember">04.</span> Why
                    Us</a>
                <a href="#blogs" class="relative hover:text-forest transition"><span class="text-ember">05.</span>
                    Blogs</a>
            </nav>
            <div class="flex items-center gap-3">
                <a href="#contact" data-cursor="hover"
                    class="btn-square hidden sm:inline-flex items-center gap-2 bg-ink text-white font-mono text-[11px] uppercase tracking-[0.16em] px-5 py-3 border border-ink">
                    <span class="fill"></span><span class="relative">Let's Talk</span>
                </a>
                <button id="menuBtn" class="lg:hidden w-10 h-10 border border-n2 grid place-items-center"
                    aria-label="Open menu">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M4 8h16M4 16h16" />
                    </svg>
                </button>
            </div>
        </div>
        <div id="mobileNav"
            class="hidden lg:hidden border-t border-n2 bg-white px-5 py-5 space-y-4 font-mono text-xs uppercase tracking-widest">
            <a href="#home" class="block">01. Home</a>
            <a href="#services" class="block">02. Services</a>
            <a href="#work" class="block">03. Work</a>
            <a href="#why-us" class="block">04. Why Us</a>
            <a href="#blogs" class="block">05. Blogs</a>
            <a href="#contact" class="inline-block mt-2 bg-ink text-white px-5 py-2.5">Let's Talk</a>
        </div>
    </header>

    <!-- ============ HERO + SHOWCASE SLIDER ============ -->
    <section id="home" class="relative overflow-hidden border-b border-n2">
        <div class="max-w-[1400px] mx-auto px-5 pt-8 pb-16 lg:pt-12">
            <div class="grid lg:grid-cols-[1.05fr_.95fr] gap-10 items-end">
                <div>
                    <h1 id="heroTitle"
                        class="font-display font-extrabold uppercase tracking-[-0.02em] text-ink mt-7 text-[13vw] leading-[0.88] lg:text-[86px]">
                        Make your brand impossible to ignore.
                    </h1>
                    <p id="hSub" class="mt-7 max-w-md text-[15px] leading-relaxed text-slategrn">
                        We are a full-platform creative studio. Strategy, identity, web design and performance
                        engineering — shipped by one senior team, end to end.
                    </p>
                    <div id="hCta" class="mt-9 flex flex-wrap items-center gap-5">
                        <a href="#work" data-cursor="hover"
                            class="btn-square inline-flex items-center gap-3 bg-forest text-white font-mono text-[11px] uppercase tracking-[0.16em] px-7 py-4">
                            <span class="fill"></span>
                            <span class="relative">Start a project</span>
                            <svg class="relative" width="15" height="15" viewBox="0 0 24 24" fill="none"
                                stroke="currentColor" stroke-width="2">
                                <path d="M5 12h14M13 6l6 6-6 6" />
                            </svg>
                        </a>
                        <a href="#work" data-cursor="hover"
                            class="group inline-flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.16em] text-ink">
                            <span
                                class="grid place-items-center w-10 h-10 border border-ink group-hover:bg-ink group-hover:text-leaf transition-colors">
                                <svg class="transition-transform group-hover:translate-x-0.5" width="14" height="14"
                                    viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M5 12h14M13 6l6 6-6 6" />
                                </svg>
                            </span> See the work
                        </a>
                    </div>
                    <div id="hMeta"
                        class="mt-10 flex flex-wrap gap-x-8 gap-y-3 border-t border-n2 pt-5 font-mono text-[10px] uppercase tracking-[0.18em] text-slate">
                        <span>Trusted by 120+ brands</span><span class="text-ember">/</span>
                        <span>144+ sites shipped</span><span class="text-ember">/</span>
                        <span>4.9 avg rating</span>
                    </div>
                </div>

                <!-- Showcase animated slider -->
                <div class="relative" id="showWrap">
                    <div class="corners relative aspect-[4/5] lg:aspect-[4/4.6] bg-night overflow-hidden"
                        id="showSlider">
                        <div class="show-slide active" data-idx="0">
                            <img class="show-img w-full h-full object-cover"
                                src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1600&q=80"
                                alt="Nexora headquarters" />
                            <div
                                class="absolute inset-0 bg-gradient-to-t from-[#0f1518]/85 via-transparent to-transparent">
                            </div>
                            <div class="show-cap absolute bottom-0 left-0 right-0 p-6 lg:p-7">
                                <p class="font-mono text-[10px] uppercase tracking-huge text-leaf">Case 01 — B2B / SaaS
                                </p>
                                <h3
                                    class="font-display font-bold uppercase text-white text-2xl lg:text-3xl mt-1 leading-none">
                                    Nexora</h3>
                                <p class="text-white/70 text-sm mt-2 max-w-sm">81% top-3 keywords · 47% demo conversion
                                </p>
                            </div>
                        </div>
                        <div class="show-slide" data-idx="1">
                            <img class="show-img w-full h-full object-cover"
                                src="https://images.unsplash.com/photo-1441986300917-64674bd600d8?auto=format&fit=crop&w=1600&q=80"
                                alt="Lumen flagship retail" />
                            <div
                                class="absolute inset-0 bg-gradient-to-t from-[#0f1518]/85 via-transparent to-transparent">
                            </div>
                            <div class="show-cap absolute bottom-0 left-0 right-0 p-6 lg:p-7">
                                <p class="font-mono text-[10px] uppercase tracking-huge text-leaf">Case 02 — Ecommerce
                                </p>
                                <h3
                                    class="font-display font-bold uppercase text-white text-2xl lg:text-3xl mt-1 leading-none">
                                    Lumen</h3>
                                <p class="text-white/70 text-sm mt-2 max-w-sm">55x organic traffic · 1.8x average order
                                </p>
                            </div>
                        </div>
                        <div class="show-slide" data-idx="2">
                            <img class="show-img w-full h-full object-cover"
                                src="https://images.unsplash.com/photo-1551650975-87deedd944c3?auto=format&fit=crop&w=1600&q=80"
                                alt="Solvio fintech product" />
                            <div
                                class="absolute inset-0 bg-gradient-to-t from-[#0f1518]/85 via-transparent to-transparent">
                            </div>
                            <div class="show-cap absolute bottom-0 left-0 right-0 p-6 lg:p-7">
                                <p class="font-mono text-[10px] uppercase tracking-huge text-leaf">Case 03 — Product</p>
                                <h3
                                    class="font-display font-bold uppercase text-white text-2xl lg:text-3xl mt-1 leading-none">
                                    Solvio</h3>
                                <p class="text-white/70 text-sm mt-2 max-w-sm">60% more leads · 53% engaged sessions</p>
                            </div>
                        </div>
                        <div class="show-slide" data-idx="3">
                            <img class="show-img w-full h-full object-cover"
                                src="https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1600&q=80"
                                alt="Kindred consulting studio" />
                            <div
                                class="absolute inset-0 bg-gradient-to-t from-[#0f1518]/85 via-transparent to-transparent">
                            </div>
                            <div class="show-cap absolute bottom-0 left-0 right-0 p-6 lg:p-7">
                                <p class="font-mono text-[10px] uppercase tracking-huge text-leaf">Case 04 — B2B</p>
                                <h3
                                    class="font-display font-bold uppercase text-white text-2xl lg:text-3xl mt-1 leading-none">
                                    Kindred</h3>
                                <p class="text-white/70 text-sm mt-2 max-w-sm">3x domain rating · 14x organic traffic
                                </p>
                            </div>
                        </div>

                        <!-- top tag -->
                        <div
                            class="absolute top-4 left-4 z-10 bg-white/10 backdrop-blur border border-white/20 px-3 py-1.5 font-mono text-[9px] uppercase tracking-huge text-white">
                            Showreel</div>
                        <!-- index -->
                        <div class="absolute top-4 right-4 z-10 font-mono text-white flex items-center gap-1 text-sm">
                            <span id="showCur">01</span><span class="text-white/40">/</span><span
                                class="text-white/40">04</span>
                        </div>
                    </div>

                    <!-- controls -->
                    <div class="flex items-center justify-between mt-4">
                        <div class="flex gap-2" id="showDots">
                            <button data-cursor="hover" data-i="0" class="show-dot w-10 h-1.5 bg-forest"></button>
                            <button data-cursor="hover" data-i="1" class="show-dot w-10 h-1.5 bg-n2"></button>
                            <button data-cursor="hover" data-i="2" class="show-dot w-10 h-1.5 bg-n2"></button>
                            <button data-cursor="hover" data-i="3" class="show-dot w-10 h-1.5 bg-n2"></button>
                        </div>
                        <div class="flex gap-2 font-mono text-xs">
                            <button id="showPrev" data-cursor="hover" aria-label="Previous"
                                class="w-11 h-11 border border-ink grid place-items-center hover:bg-ink hover:text-leaf transition-colors">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <path d="M19 12H5M11 18l-6-6 6-6" />
                                </svg>
                            </button>
                            <button id="showNext" data-cursor="hover" aria-label="Next"
                                class="w-11 h-11 border border-ink grid place-items-center hover:bg-ink hover:text-leaf transition-colors">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <path d="M5 12h14M13 6l6 6-6 6" />
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="max-w-[1400px] mx-auto px-5 pb-8">
            <p class="font-mono text-[10px] uppercase tracking-huge text-slate mb-4">— Tools & platforms we ship</p>
